# GitHub
GITHUB_TOKEN=ghp_xxxxxxxxxxxx
GITHUB_OWNER=your-username
GITHUB_REPO=your-repo
CLAUDE_READY_LABEL=claude-ready

# Server
PORT=3456

# Paths
REPO_PATH=/path/to/your/repo
WORKTREE_DIR=./worktrees

# Polling intervals (ms)
ISSUE_SYNC_INTERVAL=60000
PR_WATCH_INTERVAL=120000

# Dispatch router (server/agents/router.ts): off | shadow | enforce. shadow (the
# default) records decide()'s output on every dispatch without changing what gets
# spawned. Only enforce lets it gate phase/model.
ROUTER_MODE=shadow

# Optional: absolute path to the orchestrator's sqlite database. Defaults to
# <repo root>/orchestrator.db (server/config.ts DB_PATH) — set this only if you
# need the database somewhere else.
# ORCHESTRATOR_DB=/path/to/orchestrator.db
